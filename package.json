{
  "name": "signal-and-friction-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/check-cloudflare-build-env.mjs && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "crm": "node scripts/crm-server.mjs",
    "check:drift": "node scripts/check-domain-drift.mjs",
    "check:offers": "node scripts/check-offer-integrity.mjs",
    "check:diagnostic-authority": "node scripts/check-diagnostic-authority.mjs",
    "check:intake-truth": "node scripts/check-intake-product-truth.mjs",
    "check:stripe-webhook": "node scripts/check-stripe-webhook-boundary.mjs && node --test src/server/stripe-webhook-boundary.test.mjs",
    "check:payment-state": "node scripts/check-payment-state-truth.mjs",
    "check:scaffold-provisioning": "node scripts/check-scaffold-provisioning-truth.mjs",
    "check:agent-build": "node scripts/check-agent-build-gate.mjs",
    "check:training-unit": "node --experimental-strip-types src/lib/training-workflow.test.mjs && node --experimental-strip-types src/lib/calibration-readiness.test.mjs",
    "check:learning-os": "node scripts/check-learning-os-truth.mjs",
    "check:finance-os": "node scripts/check-finance-os-truth.mjs",
    "predeploy": "npm run build && node scripts/check-no-placeholder-creds.mjs && npm run check:offers && npm run check:drift && npm run check:diagnostic-authority && npm run check:intake-truth && npm run check:stripe-webhook && npm run check:payment-state && npm run check:scaffold-provisioning && npm run check:agent-build && npm run check:training-unit && npm run check:learning-os && npm run check:finance-os",
    "deploy": "wrangler pages deploy out --project-name=signal-and-friction"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.108.2",
    "framer-motion": "^12.40.0",
    "next": "16.2.6",
    "playwright": "^1.61.0",
    "posthog-js": "^1.392.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "stripe": "^22.2.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "puppeteer": "^25.1.0",
    "supabase": "^2.107.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
