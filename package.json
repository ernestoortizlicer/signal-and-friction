{
  "name": "signal-and-friction-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/check-cloudflare-build-env.mjs && next build",
    "start": "next start",
    "lint": "eslint",
    "crm": "node scripts/crm-server.mjs",
    "check:drift": "node scripts/check-domain-drift.mjs",
    "check:offers": "node scripts/check-offer-integrity.mjs",
    "check:diagnostic-authority": "node scripts/check-diagnostic-authority.mjs",
    "check:intake-truth": "node scripts/check-intake-product-truth.mjs",
    "predeploy": "npm run build && node scripts/check-no-placeholder-creds.mjs && npm run check:offers && npm run check:drift && npm run check:diagnostic-authority && npm run check:intake-truth",
    "deploy": "wrangler pages deploy out --project-name=signal-and-friction"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.108.2",
    "framer-motion": "^12.40.0",
    "next": "16.2.6",
    "playwright": "^1.61.0",
    "posthog-js": "^1.392.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "stripe": "^22.2.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "puppeteer": "^25.1.0",
    "supabase": "^2.107.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
