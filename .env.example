# ════════════════════════════════════════════════════════════
# ENVIRONMENT VARIABLE RECOVERY CHECKLIST — names only, no values.
#
# Built by grepping every `env.X` (Cloudflare Functions) and
# `Deno.env.get("X")` (Supabase Edge Functions) reference in this
# codebase on 2026-08-01 — this list is generated from what the code
# actually reads at runtime, not guessed. If a fresh grep of functions/
# and supabase/functions/ ever finds a name not listed here, this file
# is stale — regenerate it, don't hand-edit it out of sync.
#
# Nothing below is a secret. Actual values live in exactly three places:
# this repo's local .env.local (gitignored, exists only on your machine —
# not backed up by git), Cloudflare Pages' dashboard, and Supabase's
# dashboard. If this laptop is lost, .env.local is gone; the other two
# are not.
# ════════════════════════════════════════════════════════════


# ── 1. Local build (.env.local — create this file yourself, gitignored) ──
# Also duplicated in Cloudflare Pages → Settings → Environment variables
# (production build), since Next.js needs these at build time.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=


# ── 2. Cloudflare Pages → Settings → Functions → Secrets ──
# Read by functions/api/*.ts via the `env` argument. Reconfigure these in
# the Cloudflare dashboard for this Pages project if rebuilding.

ADMIN_EMAILS=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
PAGESPEED_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RESEND_API_KEY=
POSTHOG_API_KEY=


# ── 3. Supabase → Project Settings → Edge Functions → Secrets ──
# Read by supabase/functions/*/index.ts via Deno.env.get(). Reconfigure
# these under the Supabase project's Edge Function secrets if rebuilding —
# separate from Cloudflare's copies above, even where the name matches.

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_PRICE_CERTIFIED_ANNUAL=
STRIPE_PRICE_CERTIFIED_MONTHLY=
STRIPE_PRICE_CERTIFIED_RENEWAL=
POSTHOG_API_KEY=
SLACK_WEBHOOK_URL=


# ── Recovery order, if rebuilding on a new machine ──
# 1. Clone the repo from GitHub (this file travels with it).
# 2. Recreate .env.local from section 1 above — values come from the
#    Supabase dashboard (Project Settings → API) and/or Cloudflare Pages'
#    existing environment variables if that project is still live.
# 3. Confirm section 2's values are still set in Cloudflare Pages (they
#    persist independently of this laptop — nothing to do unless the
#    Cloudflare project itself was also lost).
# 4. Confirm section 3's values are still set in Supabase (same —
#    independent of this laptop).
# 5. npm install && npm run build to verify the local build still works
#    end to end before deploying anything.
